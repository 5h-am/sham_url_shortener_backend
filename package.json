{
  "name": "backend",
  "version": "1.0.0",
  "description": "A url shortener",
  "license": "ISC",
  "author": "Sham",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "cross-env NODE_ENV=test vitest",
    "test:run": "cross-env NODE_ENV=test vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "db:new": "docker compose run --rm dbmate new",
    "db:up": "docker compose run --rm dbmate up",
    "db:down": "docker compose run --rm dbmate down",
    "db:rollback": "docker compose run --rm dbmate rollback",
    "db:status": "docker compose run --rm dbmate status",
    "db:wait": "docker compose run --rm dbmate wait",
    "db:dump": "docker compose run --rm dbmate dump",
    "db:migrate": "docker compose run --rm dbmate migrate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.2.0",
    "eslint": "^10.9.0",
    "globals": "^17.11.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "helmet": "^8.3.0",
    "jiti": "^2.7.0",
    "morgan": "^1.11.0"
  }
}
